#include<iostream>
using namespace std;

int main() {
    int start, end, i, j;

    cout << "Enter starting number: ";
    cin >> start;

    cout << "Enter ending number: ";
    cin >> end;

    for(i = start; i <= end; i++) {
        if(i <= 1)
            continue;

        bool prime = true;

        for(j = 2; j < i; j++) {
            if(i % j == 0) {
                prime = false;
                break;
            }
        }

        if(prime)
            cout << i << " ";
    }

    return 0;
}
