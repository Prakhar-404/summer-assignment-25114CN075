#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int start, end;

    cout << "Enter starting number: ";
    cin >> start;

    cout << "Enter ending number: ";
    cin >> end;

    for (int num = start; num <= end; num++) {
        int temp = num, sum = 0, digit;

        while (temp > 0) {
            digit = temp % 10;
            sum = sum + pow(digit, 3);
            temp = temp / 10;
        }

        if (sum == num)
            cout << num << " ";
    }

    return 0;
}
