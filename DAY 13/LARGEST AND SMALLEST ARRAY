#include <iostream>
using namespace std;

void inputArray(int arr[], int n) {
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
}

int largestElement(int arr[], int n) {
    int largest = arr[0];

    for(int i = 1; i < n; i++) {
        if(arr[i] > largest) {
            largest = arr[i];
        }
    }

    return largest;
}

int smallestElement(int arr[], int n) {
    int smallest = arr[0];

    for(int i = 1; i < n; i++) {
        if(arr[i] < smallest) {
            smallest = arr[i];
        }
    }

    return smallest;
}

int main() {
    int n;
    
    cout << "Enter size of array: ";
    cin >> n;

    int arr[n];

    cout << "Enter array elements: ";
    inputArray(arr, n);

    cout << "Largest Element = " << largestElement(arr, n) << endl;
    cout << "Smallest Element = " << smallestElement(arr, n);

    return 0;
}
