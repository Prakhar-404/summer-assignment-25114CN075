#include<iostream>
using namespace std;

int main() {
    int num, digit, sum = 0;

    cout << "Enter a number: ";
    cin >> num;

    while(num > 0) {
        digit = num % 10;   // last digit nikalega
        sum = sum + digit;  // sum me add karega
        num = num / 10;     // last digit hata dega
    }

    cout << "Sum of digits = " << sum;

    return 0;
}
